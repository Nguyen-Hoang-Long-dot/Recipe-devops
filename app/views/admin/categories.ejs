<%- include('../partials/head') %>
<h1>Quản lý danh mục</h1>
<form class="form-inline" method="post" action="/admin/categories">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="text" name="name" placeholder="Tên danh mục" required maxlength="100">
  <input type="text" name="description" placeholder="Mô tả (tùy chọn)" maxlength="255">
  <button class="btn" type="submit">Thêm</button>
</form>
<table class="table">
  <thead><tr><th>#</th><th>Danh mục</th><th>Mô tả</th><th>Số công thức</th><th></th></tr></thead>
  <tbody>
  <% categories.forEach(function (c) { %>
    <tr>
      <td><%= c.id %></td><td><%= c.name %></td><td><%= c.description || '' %></td><td><%= c.total %></td>
      <td class="actions">
        <form class="inline" method="post" action="/admin/categories/<%= c.id %>/delete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-danger" type="submit">Xóa</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<%- include('../partials/foot') %>
