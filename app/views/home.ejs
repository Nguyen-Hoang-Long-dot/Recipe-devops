<%- include('partials/head') %>
<section class="hero">
  <h1>Chia sẻ công thức nấu ăn Việt</h1>
  <form class="search" method="get" action="/">
    <input type="text" name="q" value="<%= q %>" placeholder="Tìm món ăn: phở, bún chả, chè…" maxlength="100">
    <% if (categoryId) { %><input type="hidden" name="category" value="<%= categoryId %>"><% } %>
    <button class="btn" type="submit">Tìm kiếm</button>
  </form>
</section>

<div class="layout">
  <aside class="sidebar">
    <h2>Danh mục</h2>
    <ul class="cat-list">
      <li><a class="<%= !categoryId ? 'active' : '' %>" href="/">Tất cả</a></li>
      <% categories.forEach(function (c) { %>
        <li><a class="<%= categoryId === c.id ? 'active' : '' %>" href="/?category=<%= c.id %>"><%= c.name %> <span class="muted">(<%= c.total %>)</span></a></li>
      <% }) %>
    </ul>
  </aside>
  <section class="content">
    <% if (!recipes.length) { %>
      <p class="muted">Không tìm thấy công thức phù hợp.</p>
    <% } %>
    <div class="grid">
      <% recipes.forEach(function (r) { %><%- include('partials/card', { r: r, DIFFICULTY: DIFFICULTY }) %><% }) %>
    </div>
  </section>
</div>
<%- include('partials/foot') %>
