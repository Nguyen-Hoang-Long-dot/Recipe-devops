<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Bếp Việt</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">🍲 Bếp Việt</a>
    <nav class="nav">
      <a href="/">Công thức</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/admin">Quản trị</a>
        <a href="/admin/categories">Danh mục</a>
        <form class="inline" method="post" action="/admin/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-btn" type="submit">Đăng xuất (<%= user.username %>)</button>
        </form>
      <% } else { %>
        <a href="/admin/login">Quản trị</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="container">
<% if (typeof flash !== 'undefined' && flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>
