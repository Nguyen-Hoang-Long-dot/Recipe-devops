<%- include('../partials/head') %>
<section class="form-box">
  <h1>Đăng nhập quản trị</h1>
  <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>
  <form method="post" action="/admin/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Tên đăng nhập <input type="text" name="username" required maxlength="50" autocomplete="username"></label>
    <label>Mật khẩu <input type="password" name="password" required maxlength="200" autocomplete="current-password"></label>
    <button class="btn" type="submit">Đăng nhập</button>
  </form>
</section>
<%- include('../partials/foot') %>
