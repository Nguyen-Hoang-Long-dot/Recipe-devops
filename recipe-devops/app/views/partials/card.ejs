<a class="card" href="/recipes/<%= r.id %>">
  <% if (r.image_url) { %>
    <img class="card-img" src="<%= r.image_url %>" alt="<%= r.title %>" loading="lazy">
  <% } else { %>
    <div class="card-img placeholder">🍽️</div>
  <% } %>
  <div class="card-body">
    <span class="badge"><%= r.category_name %></span>
    <h3><%= r.title %></h3>
    <p class="muted"><%= r.description ? (r.description.length > 110 ? r.description.slice(0, 110) + '…' : r.description) : '' %></p>
    <div class="meta">⏱ <%= r.cook_time %> phút · 👥 <%= r.servings %> người · <%= DIFFICULTY[r.difficulty] %></div>
  </div>
</a>
